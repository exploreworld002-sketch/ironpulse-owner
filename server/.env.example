# Copy to server/.env. Never commit secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/ironpulse
JWT_SECRET=
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
GYM_ID=ironpulse
# For production: NODE_ENV=production, HTTPS APP_ORIGIN,
# and provision a unique admin with a strong password before first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Gym Admin
# Set only to the exact number of trusted reverse proxy hops, if applicable.
TRUST_PROXY_HOPS=
